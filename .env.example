# dwr-eo-toolkit environment configuration
#
# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# real credentials here.
#
#   cp .env.example .env
#
# Format notes, because python-dotenv fails quietly on malformed lines:
#   - KEY=value, no spaces around =
#   - quote any value containing # or spaces
#   - no `export` prefix
#   - a repeated key silently keeps the LAST occurrence
# A line it cannot parse is skipped with a warning and the variable is simply
# absent, which surfaces much later as a confusing connection or auth error.

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# The hostname depends on where the process runs, and this is the setting that
# most often goes wrong:
#
#   postgres    - the Docker Compose service name. Resolves only on the
#                 compose network. Correct when the API runs in a container.
#   localhost   - a Postgres running directly on your machine (WSL, bare
#                 metal). Correct when running uvicorn or alembic by hand.
#
# Both work. alembic/env.py uses whatever you set here verbatim.
POSTGRES_DB=dwr_eo_toolkit_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Docker Compose:
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/dwr_eo_toolkit_dev

# Local Postgres (uncomment and comment the line above):
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/dwr_eo_toolkit_dev

# --------------------------------------------------------------------------
# NASA Earthdata
# --------------------------------------------------------------------------
# Bearer token from https://urs.earthdata.nasa.gov/ -> Generate Token.
# Tokens expire; an expired one fails at request time, not at startup.
#
# Required by POST /api/v1/downloads/start and /search, which query CMR and
# download granules. NOT needed for POST /api/v1/downloads, which only writes
# a pending row -- useful for testing the database independently of
# credentials.
#
# The token is long (several hundred characters). Keep it on ONE line with no
# quotes and no trailing whitespace.
EARTHDATA_TOKEN=

# --------------------------------------------------------------------------
# API server
# --------------------------------------------------------------------------
# 0.0.0.0 to accept connections from outside the container; 127.0.0.1 to
# restrict to the local machine.
API_HOST=0.0.0.0
API_PORT=8000

# Enables reload and verbose error responses. Never true in production.
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-real-one-do-not-use-this

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Unbuffered stdout so logs appear immediately in `docker compose logs`.
# Only meaningful in a container; harmless elsewhere.
PYTHONUNBUFFERED=1
